# Copy this file to "keystore.properties" (same folder) and fill in your own values.
# keystore.properties is git-ignored: it holds passwords and must NEVER be committed.
#
# Keep the .jks file OUTSIDE the project folder and back it up (USB drive / password manager).
# If you lose it, you can never publish an update to the same app again.
storeFile=E:/Projects/Android-Development/keys/ekatra-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=ekatra
keyPassword=YOUR_KEYSTORE_PASSWORD
